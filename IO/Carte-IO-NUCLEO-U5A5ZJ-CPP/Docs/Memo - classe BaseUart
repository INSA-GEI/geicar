    HAL_StatusTypeDef receiveCircular(uint8_t* buffer, uint16_t size);

    // Méthodes virtuelles pour les callbacks, à redéfinir dans les classes dérivées
    virtual void onTxComplete() {}
    virtual void onRxComplete() {}
    virtual void onError() {}

protected:
    ExtendedUartHandle* _huart;

private:
    static void txCompleteCallback(UART_HandleTypeDef *huart);
    static void rxCompleteCallback(UART_HandleTypeDef *huart);
    static void errorCallback(UART_HandleTypeDef *huart);
};

