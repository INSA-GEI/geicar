#ifndef BASE_UART_H
#define BASE_UART_H

#include "stm32f4xx_hal.h" // Adapter selon la famille STM32 utilisée

// Structure étendue pour ajouter un pointeur utilisateur
typedef struct {
    UART_HandleTypeDef huart; // Structure HAL standard
    void* pUserData;          // Pointeur vers la classe spécifique
} ExtendedUartHandle;

// CRTP : La classe de base prend la classe dérivée en template
template <typename Derived>
class BaseUart {
public:
    BaseUart(ExtendedUartHandle* huart);
    
    void configure(uint32_t baudrate);

    HAL_StatusTypeDef sendDataIT(uint8_t* data, uint16_t size);
    HAL_StatusTypeDef sendDataDMA(uint8_t* data, uint16_t size);

    HAL_StatusTypeDef receiveDataIT(uint8_t* buffer, uint16_t size);
    HAL_StatusTypeDef receiveDataDMA(uint8_t* buffer, uint16_t size);
    HAL_StatusTypeDef receiveCircular(uint8_t* buffer, uint16_t size);

protected:
    ExtendedUartHandle* _huart;

private:
    static void txCompleteCallback(UART_HandleTypeDef *huart);
    static void rxCompleteCallback(UART_HandleTypeDef *huart);
    static void errorCallback(UART_HandleTypeDef *huart);
};

// Implémentation dans le header (CRTP oblige)
template <typename Derived>
BaseUart<Derived>::BaseUart(ExtendedUartHandle* huart) : _huart(huart) {
    _huart->pUserData = static_cast<Derived*>(this); // Associe l'objet dérivé à l'UART
}

template <typename Derived>
void BaseUart<Derived>::configure(uint32_t baudrate) {
    _huart->huart.Init.BaudRate = baudrate;
    _huart->huart.Init.WordLength = UART_WORDLENGTH_8B;
    _huart->huart.Init.StopBits = UART_STOPBITS_1;
    _huart->huart.Init.Parity = UART_PARITY_NONE;
    _huart->huart.Init.Mode = UART_MODE_TX_RX;
    _huart->huart.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    _huart->huart.Init.OverSampling = UART_OVERSAMPLING_16;

    HAL_UART_Init(&_huart->huart);

    // Enregistrement des callbacks
    HAL_UART_RegisterCallback(&_huart->huart, HAL_UART_TX_COMPLETE_CB_ID, txCompleteCallback);
    HAL_UART_RegisterCallback(&_huart->huart, HAL_UART_RX_COMPLETE_CB_ID, rxCompleteCallback);
    HAL_UART_RegisterCallback(&_huart->huart, HAL_UART_ERROR_CB_ID, errorCallback);
}

template <typename Derived>
HAL_StatusTypeDef BaseUart<Derived>::sendDataIT(uint8_t* data, uint16_t size) {
    return HAL_UART_Transmit_IT(&_huart->huart, data, size);
}

template <typename Derived>
HAL_StatusTypeDef BaseUart<Derived>::sendDataDMA(uint8_t* data, uint16_t size) {
    return HAL_UART_Transmit_DMA(&_huart->huart, data, size);
}

template <typename Derived>
HAL_StatusTypeDef BaseUart<Derived>::receiveDataIT(uint8_t* buffer, uint16_t size) {
