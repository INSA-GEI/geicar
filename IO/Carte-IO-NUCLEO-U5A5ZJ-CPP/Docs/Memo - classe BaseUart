    BaseUart* instance = static_cast<BaseUart*>(huart->pUserData);
    if (instance) instance->onTxComplete();
}

void BaseUart::rxCompleteCallback(UART_HandleTypeDef *huart) {
    BaseUart* instance = static_cast<BaseUart*>(huart->pUserData);
    if (instance) instance->onRxComplete();
}

void BaseUart::errorCallback(UART_HandleTypeDef *huart) {
    BaseUart* instance = static_cast<BaseUart*>(huart->pUserData);
    if (instance) instance->onError();
}
