    HAL_UART_Init(_huart);

    // Enregistrement des callbacks
    HAL_UART_RegisterCallback(_huart, HAL_UART_TX_COMPLETE_CB_ID, txCompleteCallback);
    HAL_UART_RegisterCallback(_huart, HAL_UART_RX_COMPLETE_CB_ID, rxCompleteCallback);
    HAL_UART_RegisterCallback(_huart, HAL_UART_ERROR_CB_ID, errorCallback);
}

HAL_StatusTypeDef BaseUart::sendDataIT(uint8_t* data, uint16_t size) {
