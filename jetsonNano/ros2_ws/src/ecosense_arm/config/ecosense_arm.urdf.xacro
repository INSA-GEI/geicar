<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ecosense_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ecosense_arm urdf file -->
    <xacro:include filename="$(find ecosense_arm)/urdf/ecosense_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ecosense_arm.ros2_control.xacro" />

    <xacro:ecosense_arm_ros2_control name="ECOSenseArm" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
